{
  "rewrites": [
    {
      "source": "/auth",
      "destination": "http://142.132.168.47/auth/"
    },
    {
      "source": "/auth/:path*",
      "destination": "http://142.132.168.47/auth/:path*"
    },
    {
      "source": "/.well-known/jwks.json",
      "destination": "http://142.132.168.47/.well-known/jwks.json"
    },
    {
      "source": "/ashsim",
      "destination": "http://142.132.168.47:3001/"
    },
    {
      "source": "/ashsim/:path*",
      "destination": "http://142.132.168.47:3001/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://142.132.168.47/api/:path*"
    },
    {
      "source": "/ashmop",
      "destination": "http://142.132.168.47/ashmop/"
    },
    {
      "source": "/ashmop/:path*",
      "destination": "http://142.132.168.47/ashmop/:path*"
    },
    {
      "source": "/admin",
      "destination": "http://142.132.168.47/fleetintelligence/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "http://142.132.168.47/fleetintelligence/admin/:path*"
    },
    {
      "source": "/fleetintelligence/api/:path*",
      "destination": "http://142.132.168.47/fleetintelligence/api/:path*"
    },
    {
      "source": "/fleetintelligence",
      "destination": "http://142.132.168.47/fleetintelligence/"
    },
    {
      "source": "/fleetintelligence/:path*",
      "destination": "http://142.132.168.47/fleetintelligence/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/sim",
      "destination": "/ashsim",
      "permanent": true
    },
    {
      "source": "/sim/:path*",
      "destination": "/ashsim/:path*",
      "permanent": true
    }
  ]
}
